# =====================================================================
#  ENVIRONMENT VARIABLES — Sistem Penjurian Karya HTML
#  Salin file ini menjadi .env.local (untuk dev) dan isi di Vercel
#  (Project Settings > Environment Variables) untuk production.
# =====================================================================

# --- Koneksi Database Neon Postgres ---
# Ambil dari Neon Dashboard > Connection string (pilih "Pooled connection").
# Contoh: postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Kunci rahasia untuk menandatangani token sesi (JWT) ---
# Buat string acak panjang & sulit ditebak. Jangan dibagikan.
# Contoh cara membuat (di terminal): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Akun Admin utama ---
# Admin login memakai kredensial ini (tidak perlu disimpan di DB).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# --- CORS (opsional) ---
# Jika frontend & API berada di domain yang sama, biarkan default "*" tidak masalah.
# Untuk lebih aman, isi dengan origin spesifik, mis: https://aiforallhackathon.com
ALLOWED_ORIGIN=*

# --- Jendela waktu penjurian (opsional) ---
# Juri hanya bisa login di antara OPEN dan CLOSE. Di luar itu halaman utama menampilkan
# countdown (sebelum buka) atau "Judging Closed" (setelah tutup). Admin tetap bisa login.
# Format ISO 8601. Default di kode: buka 6 Nov 2026 00:00 WIB, tutup 8 Nov 2026 15:00 WIB.
JUDGING_OPENS_AT=2026-11-06T00:00:00+07:00
JUDGING_CLOSES_AT=2026-11-08T15:00:00+07:00

# --- Leaderboard publik (opsional) ---
# Set "false" untuk menyembunyikan leaderboard publik. Default tampil.
LEADERBOARD_PUBLIC=true
